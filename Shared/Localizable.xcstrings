    "privacy.body": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Screenshots, to-dos, and preferences are stored on your device. The app has no account, ads, analytics, or app-operated server. Photos access is used only for the screenshots you choose to review or delete. Notifications are scheduled on your device and hide your notes by default. Purchases and restoration use Apple’s App Store. A shared card contains counts and a link; it carries no screenshot or personal note."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "截图、待办和偏好保存在本机。应用无账号、广告、统计或自建服务器。相册权限用于复核和删除你选择的截图。提醒由本机计划，默认隐藏用途。购买与恢复使用 Apple App Store。分享卡只包含数量和链接，不含截图和个人备注。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "截圖、待辦和偏好儲存在本機。App 無帳號、廣告、統計或自建伺服器。相簿權限用於檢查和刪除你選擇的截圖。提醒由本機排程，預設隱藏用途。購買及回復購買使用 Apple App Store。分享卡只包含數量和連結，不含截圖和個人備註。"
          }
        }
      }
    },
