    "store.introBody": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Try unlimited to-dos, old screenshot review, widgets, and repeat reminders for 30 days. Then keep up to 10 open to-dos for free, with access to your existing screenshots. No subscription or automatic charge."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "前 30 天可体验无限待办、清旧账、小组件和重复提醒。到期后免费同时保有 10 张未办截图，原有截图仍可访问。无订阅，不自动扣费。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "前 30 天可體驗無限待辦、清理舊截圖、小工具和重複提醒。到期後免費同時保有 10 張未辦截圖，原有截圖仍可存取。無訂閱，不會自動扣款。"
          }
        }
      }
    },
